        LFetch["fetch /api/collections"] --> LState[("copy A<br/>(sidebar)")]
        LState --> SB["AppSidebar shows it"]
        NewBtn["+ New Collection"] --> Create["POST /api/collections"]
        Create --> AddA["update copy A only"]
